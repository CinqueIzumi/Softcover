root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
# Style is enforced by the custom ktlint ruleset in :ktlint-rules (run via ./gradlew ktlintFormat /
# ktlintCheck), NOT by ktlint's standard rules — those would reformat against this project's
# idiosyncratic CODE_STYLE_GUIDE.md. Disabling the standard ruleset here also stops any IDE ktlint
# plugin from reformatting on save.
ktlint_standard = disabled
