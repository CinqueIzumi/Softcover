root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
# Style is enforced by the nl.rhaydus:ktlint-rules ruleset (run via ./gradlew ktlintFormat /
# ktlintCheck), NOT by ktlint's standard rules — those would reformat against
# docs/rhaydus/0.3.1/code-style.md. Disabling the standard ruleset here also stops any IDE ktlint
# plugin from reformatting on save.
ktlint_standard = disabled
ij_kotlin_imports_layout = *,java.**,javax.**,kotlin.**,^
