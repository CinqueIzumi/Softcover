root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
# Style is enforced by nl.rhaydus:ktlint-rules (run via ./gradlew ktlintFormat / ktlintCheck),
# which adds only ktlint's standard indent rule, whatever this file says. The rest of the
# standard ruleset would reformat against foundation/docs/code-style.md; disabling it here also
# stops any IDE ktlint plugin from reformatting on save.
ktlint_standard = disabled
ij_kotlin_imports_layout = *,java.**,javax.**,kotlin.**,^
rhaydus_fully_qualified_exempt_package_segments = fragment
