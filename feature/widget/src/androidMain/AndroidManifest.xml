<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <receiver
            android:name="nl.rhaydus.softcover.feature.widget.currentlyreading.CurrentlyReadingWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/currently_reading_widget_info" />
        </receiver>

        <receiver
            android:name="nl.rhaydus.softcover.feature.widget.randompick.RandomPickWidgetReceiver"
            android:exported="true"
            android:label="@string/random_pick_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/random_pick_widget_info" />
        </receiver>

        <activity
            android:name="nl.rhaydus.softcover.feature.widget.settings.RandomPickSettingsActivity"
            android:exported="true"
            android:label="@string/random_pick_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>

</manifest>
