<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <receiver
            android:name="nl.rhaydus.softcover.feature.widget.presentation.glance.CurrentlyReadingWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/currently_reading_widget_info" />
        </receiver>

        <receiver
            android:name="nl.rhaydus.softcover.feature.widget.presentation.glance.RandomPickWidgetReceiver"
            android:exported="true"
            android:label="@string/random_pick_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/random_pick_widget_info" />
        </receiver>

        <activity
            android:name="nl.rhaydus.softcover.feature.widget.presentation.activity.RandomPickSettingsActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/random_pick_widget_label"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name="nl.rhaydus.softcover.feature.widget.presentation.glance.TrendingWidgetReceiver"
            android:exported="true"
            android:label="@string/trending_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/trending_widget_info" />
        </receiver>

        <activity
            android:name="nl.rhaydus.softcover.feature.widget.presentation.activity.TrendingSettingsActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/trending_widget_label"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name="nl.rhaydus.softcover.feature.widget.presentation.glance.QuoteWidgetReceiver"
            android:exported="true"
            android:label="@string/quote_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quote_widget_info" />
        </receiver>

        <receiver
            android:name="nl.rhaydus.softcover.feature.widget.presentation.worker.WidgetTimeChangedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <activity
            android:name="nl.rhaydus.softcover.feature.widget.presentation.activity.UpdateProgressActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.Softcover.UpdateProgress" />
    </application>

</manifest>
